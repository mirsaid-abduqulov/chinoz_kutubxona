generator client {
  provider = "prisma-client-js"
  output   = "../src/core/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  LIBRARIAN
}

model User {
  id                   String    @id @default(uuid())
  phone_number         String    @unique
  email                String?   @unique
  full_name            String
  hashed_password      String
  hashed_refresh_token String?
  refresh_token_jti    String?
  role                 UserRole  @default(LIBRARIAN)
  is_login             Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  books                Book[]
  announcements        Announcement[]
  news                 News[]
  events               Event[]
  documents            Document[]
  media_albums         MediaAlbum[]
}

model Genre {
  id          String      @id @default(uuid())
  name_latin  String      @unique
  name_cyril  String      @unique
  name_ru     String      @unique
  books       GenreBook[]
}

model Author {
  id                     String        @id @default(uuid())
  full_name_latin        String
  full_name_cyril        String
  full_name_ru           String
  biography_latin        String?
  biography_cyril        String?
  biography_ru           String?
  nationality_latin      String?
  nationality_cyril      String?
  nationality_ru         String?
  birth_date             String?
  death_date             String?
  books                  Book[]
  images                 AuthorImage[]
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
}

model AuthorImage {
  id         String   @id @default(uuid())
  author_id  String
  author     Author   @relation(fields: [author_id], references: [id], onDelete: Cascade)
  url        String
  is_main    Boolean  @default(false)
  order      Int      @default(0)
  created_at DateTime @default(now())
}

model Book {
  id                    String      @id @default(uuid())
  name_latin            String
  name_cyril            String
  name_ru               String
  description_latin     String?
  description_cyril     String?
  description_ru        String?
  author_id             String
  published_date        DateTime?
  grade_level           Int?
  creator_id            String
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  genres                GenreBook[]
  creator               User?       @relation(fields: [creator_id], references: [id])
  author                Author?     @relation(fields: [author_id], references: [id])
  images                BookImage[]
  files                 BookFile[]
  download_count        Int               @default(0)
  rating_score          Float             @default(0)
  weekly_trend_score    Float             @default(0)
  score_updated_at      DateTime?
  download_logs         BookDownloadLog[]
  online_requests       OnlineRequest[]
}

model BookImage {
  id         String   @id @default(uuid())
  book_id    String
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  url        String
  is_main    Boolean  @default(false)
  order      Int      @default(0)
  created_at DateTime @default(now())
}

model BookFile {
  id         String   @id @default(uuid())
  book_id    String
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  url        String
  file_type  FileType
  file_name  String
  file_size  Int?
  order      Int      @default(0)
  created_at DateTime @default(now())
}

enum FileType {
  PDF
  EXCEL
  WORD
  IMAGE
  OTHER
}

model GenreBook {
  id      String @id @default(uuid())
  book    Book   @relation(fields: [bookId], references: [id])
  genre   Genre  @relation(fields: [genreId], references: [id])
  bookId  String
  genreId String

  @@unique([bookId, genreId])
}

model Banner {
  id          String   @id @default(uuid())
  title_latin String?
  title_cyril String?
  title_ru    String?
  image_url   String
  link_url    String?
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Announcement {
  id            String   @id @default(uuid())
  title_latin   String
  title_cyril   String
  title_ru      String
  content_latin String
  content_cyril String
  content_ru    String
  cover_image   String?
  is_public  Boolean  @default(true)
  published_at  DateTime @default(now())
  creator_id    String
  creator       User     @relation(fields: [creator_id], references: [id])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model UsefulLink {
  id          String  @id @default(uuid())
  title_latin String
  title_cyril String
  title_ru    String
  url         String
  icon        String?
  order       Int     @default(0)
  is_active   Boolean @default(true)
}

model BookDownloadLog {
  id            String   @id @default(uuid())
  book_id       String
  book          Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  downloaded_at DateTime @default(now())

  @@index([book_id, downloaded_at])
}

enum PageSlug {
  ABOUT
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  FAQ
  RULES
  CONTACTS
}

model Page {
  id            String   @id @default(uuid())
  slug          PageSlug @unique
  title_latin   String
  title_cyril   String
  title_ru      String
  content_latin String   // @db.Text (uzun matn uchun)
  content_cyril String   // @db.Text
  content_ru    String   // @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model DepartmentMember {
  id                 String   @id @default(uuid())
  full_name_latin    String
  full_name_cyril    String
  full_name_ru       String
  position_latin     String?
  position_cyril     String?
  position_ru        String?
  phone              String? @unique
  email              String? @unique
  fax                String? @unique
  reception_days     String?
  position_order     Int       @default(0)
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}

model News {
  id            String   @id @default(uuid())
  title_latin   String
  title_cyril   String
  title_ru      String
  content_latin String
  content_cyril String
  content_ru    String
  cover_image   String?
  is_public  Boolean  @default(true)
  published_at  DateTime @default(now())
  creator_id    String
  creator       User     @relation(fields: [creator_id], references: [id])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Event {
  id                 String   @id @default(uuid())
  title_latin        String
  title_cyril        String
  title_ru           String
  description_latin  String?
  description_cyril  String?
  description_ru     String?
  location_latin     String?
  location_cyril     String?
  location_ru        String?
  cover_image        String?
  event_date         DateTime
  is_public          Boolean  @default(true)
  creator_id         String
  creator            User     @relation(fields: [creator_id], references: [id])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

enum DocumentCategory {
  LAW
  DECISION
  ORDER
  REPORT
}

model Document {
  id           String           @id @default(uuid())
  title_latin  String
  title_cyril  String
  title_ru     String
  category     DocumentCategory
  file_url     String
  file_name    String
  file_size    Int?
  published_at DateTime         @default(now())
  creator_id   String
  is_public    Boolean          @default(false)
  creator      User             @relation(fields: [creator_id], references: [id])
  created_at   DateTime         @default(now())
  updated_at   DateTime         @default(now()) @updatedAt
}

enum MediaType {
  PHOTO
  VIDEO
  PRESENTATION
}
 
model MediaAlbum {
  id          String      @id @default(uuid())
  title_latin String
  title_cyril String
  title_ru    String
  type        MediaType
  cover_image String?
  items       MediaItem[]
  is_public   Boolean     @default(true)
  creator_id  String
  creator     User        @relation(fields: [creator_id], references: [id])
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
}
 
model MediaItem {
  id         String     @id @default(uuid())
  album_id   String
  album      MediaAlbum @relation(fields: [album_id], references: [id], onDelete: Cascade)
  url        String     // Video URL (YouTube, Vimeo) yoki File Storage URL
  file_name  String
  file_size  Int?
  thumbnail  String?    // Faqat PHOTO va PRESENTATION uchun
  order      Int        @default(0)
  created_at DateTime   @default(now())
}

enum OnlineRequestType {
  BOOK_ORDER
  INQUIRY
  QUESTION_ANSWER
  VIRTUAL_REFERENCE
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  DONE
}

model OnlineRequest {
  id          String            @id @default(uuid())
  type        OnlineRequestType
  full_name   String
  phone       String?
  email       String?
  book_id     String?
  book        Book?             @relation(fields: [book_id], references: [id])
  message     String
  answer      String?
  status      RequestStatus     @default(NEW)
  created_at  DateTime          @default(now())
  answered_at DateTime?
}

model ContactInfo {
  id             String   @id @default(uuid())
  address_latin  String
  address_cyril  String
  address_ru     String
  phone          String
  email          String
  latitude       Float?
  longitude      Float?
  social_links   Json?
  updated_at     DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(uuid())
  full_name  String
  email      String?
  phone      String?
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}